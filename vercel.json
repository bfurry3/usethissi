{
  "buildCommand": "python3 build.py",
  "outputDirectory": "dist",
  "framework": null,
  "headers": [
    {
      "source": "/kit/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}